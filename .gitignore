/target/
/src-tauri/target/
# Staged by `bun run build:overlay-hook` (Windows only).
src-tauri/overlay-hook
*.local
# Portable data created next to a Gobbo binary run from the repository root.
/data/
/gobbo.storage.json
/gobbo.portable

# Game definitions removed from the shipped catalog, kept locally for reference.
/.removed-games/

