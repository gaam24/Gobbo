# Logs
logs
*.log

node_modules
dist
# Vite CPU profiles (`vite --profile`).
*.cpuprofile
# TypeScript incremental builds (`tsc -b`).
*.tsbuildinfo
# Coverage from `bun test --coverage`.
coverage/
# Archives made by `bun run build` (see scripts/package-release.ts).
dist-release
# Cargo build output and tooling scratch space (e2e data, `jscpd`, `sbom`, screenshots).
# Anchored so a Rust module file or folder named `target` is never ignored again.
/target/
/src-tauri/target/
# Staged by `bun run build:overlay-hook` (Windows only).
src-tauri/overlay-hook
*.local
# Portable data created next to a Gobbo binary run from the repository root.
/data/
/gobbo.storage.json
/gobbo.portable

# Skills downloaded by agent tooling. Only Gobbo's own skills are tracked, so the
# glob ignores the contents and the negation can still re-include a `gobbo-*` folder
# (a negation never matches inside an ignored parent directory).
/.agents/skills/*
!/.agents/skills/gobbo-*/
# Claude Code keeps a real copy of the installed skills here on Windows.
/.claude/skills/

# Game definitions removed from the shipped catalog, kept locally for reference.
/.removed-games/

# Editor directories and files
.idea
.vs/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.cache*
*.exe*
plans/
design/

# Lefthook local overrides.
lefthook-local.yml
lefthook-local.yaml
lefthook-local.toml
lefthook-local.json
lefthook-local.jsonc
