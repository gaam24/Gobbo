{
	"name": "gobbo",
	"private": true,
	"version": "0.1.0",
	"description": "Gobbo Mods Organizer: a mod manager for PC games.",
	"license": "GPL-3.0-only",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite",
		"build": "bun scripts/build-release.ts",
		"build:web": "tsc && vite build && bun scripts/check-e2e-hooks.ts",
		"build:web:e2e": "tsc && vite build --mode e2e",
		"preview": "vite preview",
		"analyze": "vite build --mode analyze",
		"tauri": "tauri",
		"build:overlay-hook": "bun scripts/build-overlay-hook.ts",
		"package": "bun scripts/package-release.ts",
		"lint": "biome check && oxlint --type-aware && tsc --noEmit && bun run e2e:types && bun run guard",
		"guard": "bun scripts/check-layers.ts && bun scripts/check-agent-policy.ts && bun scripts/check-data-boundary.ts && bun scripts/check-overlay-invariants.ts && bun scripts/check-generated.ts",
		"lint:fix": "biome check --write && oxlint --type-aware --fix",
		"test": "bun test",
		"e2e": "bun scripts/e2e-run.ts",
		"e2e:smoke": "bun scripts/e2e-run.ts --smoke",
		"e2e:build": "bun run build:web:e2e && bun run tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json --features e2e",
		"e2e:types": "tsc -p e2e/tsconfig.json",
		"ui:check": "bun scripts/check-ui.ts",
		"ui:contrast": "bun scripts/check-contrast.ts",
		"size:report": "bun scripts/report-bundle-size.ts",
		"docs:check": "bun scripts/check-docs-links.ts",
		"translations:check": "bun scripts/check-translation-leftovers.ts",
		"bench:list": "bun scripts/bench-list.ts",
		"icons": "bun scripts/icons.ts",
		"icons:check": "bun scripts/icons.ts --check",
		"deadcode": "knip",
		"check:rust": "cd src-tauri && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --features bench --locked",
		"prepare": "lefthook install",
		"sbom": "bun scripts/sbom.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-virtual": "^3.14.26",
		"@tanstack/redact": "^0.2.3",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.1",
		"lucide-react": "^1.66.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.16.1",
		"smol-toml": "^1.9.1",
		"sonner": "^2.0.8",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@tauri-apps/cli": "^2.12.4",
		"@types/bun": "^1.4.4",
		"@types/mocha": "10.0.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@wdio/cli": "9.31.9",
		"@wdio/globals": "9.31.3",
		"@wdio/local-runner": "9.31.9",
		"@wdio/mocha-framework": "9.31.9",
		"@wdio/spec-reporter": "9.31.2",
		"@wdio/tauri-service": "1.5.1",
		"fflate": "^0.8.3",
		"knip": "^6.44.1",
		"lefthook": "^2.2.2",
		"oxc-transform-react": "^0.156.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"rollup-plugin-visualizer": "^7.1.1",
		"shadcn": "^4.23.0",
		"sharp": "^0.35.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.5",
		"webdriverio": "9.31.9"
	}
}
